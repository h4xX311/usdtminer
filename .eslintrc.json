{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "globals": {
    "ethers": "readonly"
  },
  "ignorePatterns": [
    "node_modules/",
    "js/ethers.umd.min.js"
  ],
  "rules": {
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  }
}
